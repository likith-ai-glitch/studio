rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SHOPSTREAM SECURITY RULES
     *
     * CORE PHILOSOPHY:
     * This ruleset implements a strict User-Ownership model. Access to private user data 
     * is determined primarily by the document's path and secondarily by denormalized 
     * ownership fields within the documents.
     *
     * DATA STRUCTURE:
     * - Public Data: /categories and /products are publicly readable.
     * - Private Data: All user-specific data (Profiles, Carts, Wishlists, Orders) is
     *   nested under the path /users/{userId}.
     *
     * KEY SECURITY DECISIONS:
     * 1. Path-Based Authorization: The {userId} wildcard in the path is used as the 
     *    primary authority for determining document ownership.
     * 2. Denormalization for Authorization: To ensure efficient listing and high performance
     *    without using costly get() calls, sub-resources (like CartItems or OrderItems) 
     *    MUST store the owner's UID (userId) directly on the document.
     * 3. Restricted Admin Collections: Collections like /categories and /products are
     *    publicly readable but prohibit client-side writes, assuming these are managed 
     *    by administrative tools or backend services.
     * 4. Structural Segregation: User data is kept in private trees to prevent data leakage.
     */

    // --- HELPER FUNCTIONS ---

    /**
     * @description Checks if the request is from an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Validates if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Combined check for ownership and document existence for updates and deletes.
     */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the UserProfile entity. Users manage their own profile.
     * @path /users/{userId}
     * @allow (create) {auth.uid: "user123"} to /users/user123
     * @deny (get) {auth.uid: "user123"} to /users/user456
     * @principle Enforces path-based ownership for the root user document.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for the Cart entity. Restricted to the owner.
       * @path /users/{userId}/carts/{cartId}
       * @allow (get) {auth.uid: "user1"} to /users/user1/carts/cartA
       * @deny (create) {auth.uid: "user1"} to /users/user2/carts/cartB
       * @principle Enforces ownership and relational integrity for cart documents.
       */
      match /carts/{cartId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        /**
         * @description Rules for CartItems. Requires denormalized userId for secure access.
         * @path /users/{userId}/carts/{cartId}/cartItems/{cartItemId}
         * @allow (create) {auth.uid: "u1", data: {userId: "u1"}} to /users/u1/carts/c1/cartItems/i1
         * @deny (update) changing userId from "u1" to "u2"
         * @principle Uses denormalized userId to avoid parent-document lookups.
         */
        match /cartItems/{cartItemId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.userId == userId;
          allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
          allow delete: if isExistingOwner(userId);
        }
      }

      /**
       * @description Rules for the Wishlist entity. Restricted to the owner.
       * @path /users/{userId}/wishlists/{wishlistId}
       */
      match /wishlists/{wishlistId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        match /wishlistItems/{wishlistItemId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.userId == userId;
          allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
          allow delete: if isExistingOwner(userId);
        }
      }

      /**
       * @description Rules for the Order entity. Restricted to the owner.
       * @path /users/{userId}/orders/{orderId}
       */
      match /orders/{orderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        match /orderItems/{orderItemId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.userId == userId;
          allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
          allow delete: if isExistingOwner(userId);
        }
      }
    }

    /**
     * @description Rules for Product Categories. Publicly readable.
     * @path /categories/{categoryId}
     * @allow (get) Any user (including anonymous)
     * @deny (create) Any user (Client-side writes are forbidden)
     * @principle Prohibits client-side writes for reference catalog data.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add admin validation once schema supports it.
    }

    /**
     * @description Rules for the Product catalog. Publicly readable.
     * @path /products/{productId}
     * @allow (list) Any user
     * @deny (update) Any user
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add admin validation once schema supports it.

      /**
       * @description Rules for Product Description History. Readable by authenticated users.
       * @path /products/{productId}/descriptionHistory/{historyId}
       */
      match /descriptionHistory/{historyId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if false; // Managed by backend/admin services.
      }
    }
  }
}