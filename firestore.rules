rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SHOPSTREAM SECURITY RULES
     *
     * CORE PHILOSOPHY:
     * This ruleset implements a strict User-Ownership model. Access to private user data 
     * is determined primarily by the document's path and secondarily by denormalized 
     * ownership fields within the documents.
     *
     * DATA STRUCTURE:
     * - Public Data: /categories and /products are publicly readable.
     * - Private Data: All user-specific data (Profiles, Carts, Wishlists, Orders) is
     *   nested under the path /users/{userId}.
     */

    // --- HELPER FUNCTIONS ---

    /**
     * @description Checks if the request is from an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Validates if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Combined check for ownership and document existence.
     */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /**
     * @description Checks if the request is from the Super Administrator.
     */
    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.email == "likithknml@gmail.com");
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the UserProfile entity. Users manage their own profile.
     * Admins can list and manage all users.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isSuperAdmin();
      allow create: if (isOwner(userId) && request.resource.data.id == userId) || isSuperAdmin();
      allow update: if (isExistingOwner(userId) && request.resource.data.id == resource.data.id) || isSuperAdmin();
      allow delete: if isExistingOwner(userId) || isSuperAdmin();

      match /carts/{cartId} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isSuperAdmin();
        allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isSuperAdmin();
        allow delete: if isExistingOwner(userId) || isSuperAdmin();

        match /cartItems/{cartItemId} {
          allow get, list: if isOwner(userId) || isSuperAdmin();
          allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isSuperAdmin();
          allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isSuperAdmin();
          allow delete: if isExistingOwner(userId) || isSuperAdmin();
        }
      }

      match /wishlists/{wishlistId} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isSuperAdmin();
        allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isSuperAdmin();
        allow delete: if isExistingOwner(userId) || isSuperAdmin();

        match /wishlistItems/{wishlistItemId} {
          allow get, list: if isOwner(userId) || isSuperAdmin();
          allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isSuperAdmin();
          allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isSuperAdmin();
          allow delete: if isExistingOwner(userId) || isSuperAdmin();
        }
      }

      match /orders/{orderId} {
        allow get, list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isSuperAdmin();
        allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isSuperAdmin();
        allow delete: if isExistingOwner(userId) || isSuperAdmin();

        match /orderItems/{orderItemId} {
          allow get, list: if isOwner(userId) || isSuperAdmin();
          allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isSuperAdmin();
          allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isSuperAdmin();
          allow delete: if isExistingOwner(userId) || isSuperAdmin();
        }
      }
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin();

      match /descriptionHistory/{historyId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSuperAdmin();
      }
    }

    match /events/{eventId} {
      allow create: if isSignedIn();
      allow get, list: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read, write: if isSuperAdmin();
    }
  }
}