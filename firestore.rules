rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SHOPSTREAM SECURITY RULES
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.email == "likithknml@gmail.com");
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.id == userId;
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /quotes/{quoteId} {
      allow read, write: if isSignedIn();
    }

    match /quoteLineItems/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read, write: if isSuperAdmin();
    }
    
    match /events/{eventId} {
      allow create: if isSignedIn();
      allow read: if isSuperAdmin();
    }
    
    match /syncLogs/{logId} {
      allow read: if isSuperAdmin();
    }
  }
}
